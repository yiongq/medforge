# medforge 本地配置模板:复制成 .env 再填值(.env 在 .gitignore 里,绝不进仓库)
# 只有 KEY=VALUE 逐行读(见 src/medforge/env.py),不要加引号

# ── 判卷员 / 代理标注 / 参考臂的后端 ────────────────────────────────
# openai(默认)= 任何 OpenAI 兼容端点;claude-code = 本机已登录的 Claude Code CLI(用订阅额度,不用 key)
MEDFORGE_JUDGE_PROVIDER=openai

# provider=openai 时三个都要填(DeepSeek / 智谱 / 任何兼容层都行)
MEDFORGE_JUDGE_BASE_URL=https://api.deepseek.com/v1
MEDFORGE_JUDGE_API_KEY=sk-填你的key
MEDFORGE_JUDGE_MODEL=deepseek-v4-pro

# provider=claude-code 时只要模型名(写全名,裸别名 opus/sonnet 会被 CLI 钉在旧代):
#   先 `claude login` 用 Max 账号登录,再取消下面两行的注释、把上面 openai 那组注释掉
# MEDFORGE_JUDGE_PROVIDER=claude-code
# MEDFORGE_JUDGE_MODEL=claude-opus-5
# 可选:扩展思考预算档位 low|medium|high|max(不填 = 用 CLI 默认)
# MEDFORGE_JUDGE_EFFORT=high

# ── 其他 ────────────────────────────────────────────────────────
SWANLAB_API_KEY=
HF_TOKEN=
